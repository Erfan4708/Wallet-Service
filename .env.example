# Copy to .env and edit to override any of the Compose defaults.
#
# Every value here is a LOCAL DEVELOPMENT default. Nothing in this file is a
# secret, and nothing in this repository ever should be: a deployment supplies
# credentials through its own environment or secret store.
#
# .env itself is git-ignored, so anything you put there stays on your machine.

# --- Network exposure -------------------------------------------------------
# The host address every published port binds to. 127.0.0.1 keeps PostgreSQL,
# Redis (which has no password) and the management UIs off the local network.
# Use 0.0.0.0 only on a machine where that exposure is intended.
LEDGER_BIND_ADDRESS=127.0.0.1

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_PORT=55432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=16379

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=ledger
RABBITMQ_PASSWORD=ledger
RABBITMQ_PORT=45672
RABBITMQ_MANAGEMENT_PORT=45673

# --- API --------------------------------------------------------------------
API_PORT=18080
ASPNETCORE_ENVIRONMENT=Production
# The image the api and migrator services run. Change it to run a specific
# build without editing docker-compose.yml.
LEDGER_IMAGE=ledger-api:local
# The API's maximum database connection pool size. 100 is Npgsql's default;
# docs/PERFORMANCE.md (section 8.5) measures what a smaller pool costs.
LEDGER_DB_MAX_POOL_SIZE=100
# Whether the API serves its OpenAPI document and Swagger UI at /swagger.
LEDGER_OPENAPI_ENABLED=true

# --- Observability ----------------------------------------------------------
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
