# Copy to .env and edit to override any of the Compose defaults.
#
# Every value here is a LOCAL DEVELOPMENT default. Nothing in this file is a
# secret, and nothing in this repository ever should be: a deployment supplies
# credentials through its own environment or secret store.
#
# .env itself is git-ignored, so anything you put there stays on your machine.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_PORT=55432

# --- Redis ----------------------------------------------------------------
REDIS_PORT=16379

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=ledger
RABBITMQ_PASSWORD=ledger
RABBITMQ_PORT=45672
RABBITMQ_MANAGEMENT_PORT=45673

# --- API ------------------------------------------------------------------
API_PORT=18080
ASPNETCORE_ENVIRONMENT=Production

# --- Observability --------------------------------------------------------
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
